# Koneksi Database MySQL / MariaDB di VPS
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://judging:judging_password_2026@127.0.0.1:3306/judging"

# Shadow database untuk Prisma migrate dev (opsional di production, bisa dikosongkan)
# SHADOW_DATABASE_URL="mysql://judging:judging_password_2026@127.0.0.1:3306/judging_shadow"

# Lokasi penyimpanan file & foto karya (relatif atau absolut)
STORAGE_DIR="./storage"

# Lokasi binary mysqldump untuk backup otomatis di dashboard admin
# Di Ubuntu / Debian: /usr/bin/mysqldump
# Di CentOS / AlmaLinux / RHEL: /usr/bin/mysqldump
# Di aaPanel: /www/server/mysql/bin/mysqldump
MYSQLDUMP_PATH="/usr/bin/mysqldump"
BACKUP_DIR="./storage/backups"

# Kredensial akun Administrator awal
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="MBtech123"
